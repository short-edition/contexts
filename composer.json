{
    "name": "short-edition/contexts",
    "description": "Behatch contexts",
    "keywords": ["BDD", "Behat", "Symfony2", "Context"],
    "type": "library",
    "license": "beerware",

    "require": {
        "php": ">=8.5",
        "behat/behat": "4.x-dev",
        "justinrainbow/json-schema": "^6.8",
        "short-edition/mink-extension": "dev-bugfix",
        "symfony/property-access": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/dom-crawler": "^8.0"
    },

    "require-dev": {
        "guzzlehttp/guzzle": "^7|^8",
        "behat/mink-selenium2-driver": "^1.7",
        "atoum/atoum": "^4.4",
        "friendsofphp/php-cs-fixer": "^3.95"
    },

    "autoload": {
        "psr-4": {
            "Behatch\\": "src/"
        }
    },

    "scripts": {
        "cs-fixer": "php-cs-fixer fix"
    },

    "config": {
        "bin-dir": "bin/"
    },

    "replace": {
        "sanpi/behatch-contexts": "self.version"
    },

    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
